{
  "name": "zeraus",
  "private": true,
  "version": "3.0.0",
  "description": "zera.us — Next.js website + Sanity Studio monorepo",
  "author": "Lucho Suarez <lucho@zera.us>",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @zeraus/web dev",
    "dev:studio": "pnpm --filter @zeraus/studio dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typegen": "pnpm --filter @zeraus/studio typegen",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
