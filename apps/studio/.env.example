# Sanity Studio — copy to .env (gitignored). Values are inlined by the Sanity CLI.
SANITY_STUDIO_PROJECT_ID=b80qy5y0
SANITY_STUDIO_DATASET=zeraus
SANITY_STUDIO_URL=http://localhost:3333
# Optional: origin of the Next.js site. When set, the Presentation tool (visual editing) is enabled.
# Needs apps/web/app/api/draft-mode/enable (phase 3).
SANITY_STUDIO_PREVIEW_URL=

# Used by apps/studio/api/send-email.ts (Vercel function) and plugins
RESEND_API_KEY=
EMAIL_DOMAIN=
SANITY_WRITE_TOKEN=

# Optional: AI assist / embeddings
SANITY_STUDIO_ANTHROPIC_API_KEY=
SANITY_STUDIO_OPEN_AI_API_KEY=
SANITY_STUDIO_OPENAI_API_HOST=
