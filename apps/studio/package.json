  "version": "3.0.0",
  "description": "zera.us Sanity Studio (project b80qy5y0 / dataset zeraus)",
  "author": "Lucho Suarez <lucho@zera.us>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev --port 3333",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "schema:extract": "sanity schema extract --enforce-required-fields --path ./schema.json",
    "typegen": "pnpm schema:extract && sanity typegen generate",
    "typecheck": "tsc --noEmit",
    "test": "sanity check",
    "clean": "rm -rf dist .sanity schema.json"
  },
  "keywords": [
    "sanity"
  ],
