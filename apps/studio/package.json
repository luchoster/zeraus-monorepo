    "@sanity/color-input": "^6.0.4",
    "@sanity/dashboard": "^5.0.1",
    "@sanity/embeddings-index-ui": "^3.0.1",
    "@sanity/functions": "^1.2.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/ui": "^3.1.14",
    "@sanity/vision": "^5.19.0",
    "@tabler/icons-react": "^3.41.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@vercel/node": "^5.6.22",
